# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry Error Tracking
VITE_SENTRY_DSN=

# PostHog Analytics (uses reverse proxy at /ingest, configured in vercel.json)
VITE_PUBLIC_POSTHOG_KEY=

# Admin Access (comma-separated list of admin email addresses)
VITE_ADMIN_EMAILS=

# Feature Flags
VITE_RATING_IDENTITY_ENABLED=false
# Sign in with Apple defaults to ON since launch (PR #170). Set this to
# 'false' to hide the button — leave unset to keep the default.
# VITE_FEATURES_APPLE_SIGNIN=false
