# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel

# Environment / secrets. Match every .env variant so a stray .env.production
# or .env.staging never gets accidentally committed. .env.example is the only
# tracked one — it documents required vars without containing any values.
.env
.env.*
!.env.example

# Mock presentations
restaurant-presentation.html
presentation-style-1-corporate.html
presentation-style-2-dashboard.html
presentation-style-3-friendly.html

# Local Netlify folder
.netlify

# Git worktrees
.worktrees
stats.html
supabase/.temp/

# Playwright
e2e/.auth/
playwright-report/
test-results/
blob-report/
.superpowers/

# Auto-generated build artifacts
public/bundle-stats.html

# Claude Code scheduled tasks + session state — match at any depth
.claude/scheduled_tasks.lock
**/.claude/

# Capacitor / iOS build artifacts
# We commit the Xcode project, Podfile, and Podfile.lock (for reproducible
# pod installs), but not generated Pods/, build output, user data, or the
# cap-sync-ed web bundle (cap sync rewrites ios/App/public/ on each run).
ios/App/Pods/
ios/App/build/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
ios/DerivedData/
ios/**/xcuserdata/
ios/**/.xcode.env.local
ios/App/public/
